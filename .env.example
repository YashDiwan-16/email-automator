# Use a Nodemailer well-known service name, such as Gmail or Outlook365.
SMTP_SERVICE=Gmail

# For a custom SMTP server, leave SMTP_SERVICE empty and set SMTP_HOST instead.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sender@example.com
SMTP_PASSWORD=replace-with-an-app-password-or-smtp-password

MAIL_FROM_EMAIL=sender@example.com
MAIL_FROM_NAME=Product team
MAIL_REPLY_TO=reply@example.com

EMAIL_AUTOMATOR_ACCESS_TOKEN=replace-with-a-random-secret-at-least-32-characters-long
